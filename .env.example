# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# External PostgreSQL, MariaDB, or MySQL Database (Botkeep.cloud / VPS — leave blank to use local SQLite fallback)
# Set DATABASE_URL (e.g. mariadb://..., mysql://..., or postgresql://...)
# OR set discrete DB_* / PG* / MYSQL_* / MARIADB_* variables below.
DATABASE_URL=""
MYSQL_URL=""
MARIADB_URL=""
DB_HOST=""
DB_PORT=""
DB_NAME=""
DB_USER=""
DB_PASS=""
DB_SSL="false"
DB_SSL_CA=""
DB_SSL_REJECT_UNAUTHORIZED="false"

# Optional alternative variable names:
# PostgreSQL: PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE
# MySQL/MariaDB: MYSQL_HOST, MYSQL_PORT, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD, MARIADB_HOST, MARIADB_PORT, MARIADB_DATABASE, MARIADB_USER, MARIADB_PASSWORD

# Session signing secret (set a long random string in Secrets so sessions persist across restarts)
JWT_SECRET=""
PORT="3000"


