Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forward Authorization header to PHP under CGI/FastCGI/FPM
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Allow direct serving of static assets inside public/ (excluding PHP files)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteRule ^ - [L]

    # Route all API requests and React PWA paths through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
