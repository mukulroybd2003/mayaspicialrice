# Copy this file to backend-php/.env (or configure environment variables in Apache/Nginx/cPanel)
# Option 1: Single connection URL (MySQL or MariaDB)
DATABASE_URL=""
# Example: mysql://db_user:db_pass@127.0.0.1:3306/sonagrain_erp

# Option 2: Individual MySQL/MariaDB settings
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="sonagrain_erp"
DB_USER="root"
DB_PASS=""

# Optional SSL settings for remote MySQL/MariaDB
DB_SSL="false"
DB_SSL_CA=""
DB_SSL_REJECT_UNAUTHORIZED="false"

# Optional JWT secret (64+ char random string; if blank, a persistent secret is auto-generated in app_meta)
JWT_SECRET=""

# Optional allowed frontend origin (for cross-origin hosting; same-origin works automatically)
APP_URL=""
